# ── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string (include the database name in the path)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.example.net/blogwrite?retryWrites=true&w=majority"

# Signs session cookies. At least 32 characters: `openssl rand -hex 32`
JWT_SECRET=""

# Public origin of this instance, no trailing slash. Used for links in emails,
# the sitemap, OAuth metadata and the MCP connector URL. Inlined at build time.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated addresses that become admins when they sign up. Leave empty
# for none; the admin console (/admin) needs at least one.
ADMIN_EMAILS=""

# ── Scheduled jobs (news, research, topics, AI posts, learning paths) ────────

# Shared secret for /api/cron/* (at least 16 characters: `openssl rand -hex 16`).
# The in-process scheduler stays off until this is set.
CRON_SECRET=""

# Set to "false" to turn the in-process scheduler off on this instance.
ENABLE_INTERNAL_CRON="true"

# Optional: run one job once at boot to test the scheduler, e.g. "fetch-news".
CRON_FORCE_TICK=""

# ── AI (any OpenAI-compatible endpoint; nothing is sent anywhere by default) ─

# Default: a local Ollama server.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="gpt-oss:20b"

# Or point at any other OpenAI-compatible endpoint (overrides the Ollama values).
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# Optional: raises the anonymous rate limits of the free cover-image service.
POLLINATIONS_API_KEY=""

# ── Media storage: any S3-compatible bucket ─────────────────────────────────
# Without these, uploaded and AI-generated images under 2 MB are stored inline
# (data: URLs in the database), which is fine for trying BlogWrite locally.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT="https://s3.your-provider.example"
STORAGE_PUBLIC_URL="https://media.your-domain.example"
# STORAGE_REGION="auto"

# ── Email (welcome, password reset, subscription confirmation) ──────────────
# Harakumo Mail: create a key at Harakumo → Settings → API keys. Server-side
# only. Without it, emails are skipped (so password-reset links are not sent).
HARAKUMO_API_KEY=""
# HARAKUMO_BASE_URL="https://harakumo.com"

# ── Billing (optional) ──────────────────────────────────────────────────────
# Without both STRIPE_SECRET_KEY and STRIPE_PRICE_ID_WRITER, "Upgrade" opens a
# built-in checkout simulator instead (no money moves).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_WRITER=""
